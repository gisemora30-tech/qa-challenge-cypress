{
  "name": "qa-challenge-gisela-mora",
  "version": "1.0.0",
  "private": true,
  "description": "Challenge QA: Fake Store API, Sauce Demo y reporte de defectos",
  "scripts": {
    "test": "cypress run",
    "test:api": "cypress run --spec \"cypress/e2e/api/**/*.cy.js\"",
    "test:ui": "cypress run --spec \"cypress/e2e/ui/**/*.cy.js\"",
    "cy:open": "cypress open",
    "check": "node scripts/check-syntax.cjs",
    "setup:api": "node scripts/setup-api.cjs"
  },
  "devDependencies": {
    "cypress": "16.1.1"
  },
  "engines": {
    "node": ">=24 <25"
  }
}
